[Unit]
Description=VM status app
After=network.target

[Service]
User=opc
WorkingDirectory=/home/opc/vm-status-app
Environment=PATH=/home/opc/vm-status-app/venv/bin
ExecStart=/home/opc/vm-status-app/venv/bin/gunicorn -w 2 -b 127.0.0.1:5000 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
